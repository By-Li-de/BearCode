# Generic API config. Works with Anthropic-compatible endpoints such as DeepSeek.
# APIKEY=
# API=https://api.deepseek.com/anthropic
# MINI_CLAUDE_MODEL=claude-sonnet-4-6

# Optional generic aliases supported by Bear Code.
# MINI_CLAUDE_API_KEY=sk-your-api-key
# MINI_CLAUDE_API_BASE=https://api.deepseek.com/anthropic

# Anthropic native config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible config.
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# MODEL=gpt-5.2

# Runtime limits for the model/deployment selected above.
# Unknown model names default to 32768 context tokens and 4096 output tokens.
# Set these to your provider's actual limits, especially for custom deployment names.
# BEAR_CONTEXT_WINDOW=32768
# BEAR_MAX_OUTPUT_TOKENS=4096
# Optional OpenAI-compatible output field: max_tokens or max_completion_tokens.
# BEAR_OPENAI_OUTPUT_PARAMETER=max_completion_tokens

# USD per 1 million tokens, using your provider's prices for the selected model.
# Leave unset to display token counts without an invented cost estimate.
# Both prices are required to enable --max-cost. Zero is valid for a free local model.
# BEAR_INPUT_PRICE_PER_MTOK=
# BEAR_OUTPUT_PRICE_PER_MTOK=
